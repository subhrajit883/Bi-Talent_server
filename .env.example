PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail is used when SMTP_HOST is unset. For another provider, configure SMTP_HOST.
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Frontend base URL; the email opens /reset-password?token=...&role=...
# That page should POST { token, password } to /api/auth/reset-password.
FRONTEND_URL=

# Optional initial-admin credentials
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
